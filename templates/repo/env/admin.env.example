# apps/admin/.env.example — every variable the admin panel reads. Copy to .env.local and fill in.

# --- Database + storage (same Neon branch as the web app) ---
DATABASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Admin sign-in ---
ADMIN_PASSWORD=                # fallback only until a hashed password is stored in admin_settings; change it on first login
ADMIN_SESSION_SECRET=          # random 32+ bytes; signs server-side admin sessions. The e2e suite uses it to mint a session cookie.
ADMIN_EMAIL=                   # owner address: 2FA codes and save-lock codes
ADMIN_EMAIL_CC=                # optional, comma-separated: extra recipients of the 2FA sign-in code only

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="[App] <verify@[domain]>"

# --- Engines the panel reads (wallet balance, product describer) ---
TRIPO_API_KEY=
GEMINI_API_KEY=

# --- Push (broadcasts) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:[support email]

# --- Links back to the customer app ---
NEXT_PUBLIC_WEB_ORIGIN=https://[staging-app].vercel.app
NEXT_PUBLIC_APP_URL=https://[staging-app].vercel.app

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=        # a separate Sentry project from the customer app
