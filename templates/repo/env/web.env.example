# apps/web/.env.example — every variable the customer app reads. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values reach the browser; everything else stays on the server.
# Where each value comes from is in 03-services-setup.md. Never paste a value into chat or a doc.

# --- Database + storage (Neon; written by `neon env pull --file apps/web/.env.local`) ---
NEON_BRANCH=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Auth.js (Google + email/password with emailed codes) ---
AUTH_SECRET=                   # `npx auth secret` or any 32+ random bytes; same value on every deployment of this app
AUTH_GOOGLE_ID=                # Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
AUTH_GOOGLE_SECRET=
# Redirect URIs to register on that client, no trailing slash:
#   https://app.[domain]/api/auth/callback/google
#   https://[staging-app].vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google

# --- Email (Resend) ---
RESEND_API_KEY=                # "Sending access" key restricted to the domain
EMAIL_FROM="[App] <verify@[domain]>"   # only works once the domain is verified; before that Resend delivers only to the account owner

# --- AI engines (agency key on local + staging ONLY; production gets the client's own paid key) ---
GEMINI_API_KEY=                # Google AI Studio; image models have zero free quota — billing must be on
TRIPO_API_KEY=                 # 3D engine (never named in user-facing copy)
# Test switches (set by playwright.config.ts, never in a real env file): GEMINI_MOCK=1 TRIPO_MOCK=1

# --- Web push (VAPID; `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # same value as VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:[support email]

# --- Scheduler + admin ---
CRON_SECRET=                   # random; the hosting cron sends it as `Authorization: Bearer`
ADMIN_EMAIL=                   # the owner's address: admin 2FA and save-lock codes go here and nowhere else

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=        # Sentry project for the customer app
NEXT_PUBLIC_POSTHOG_KEY=       # PostHog project (public client key)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Staging only. NEVER set on production. ---
NEXT_PUBLIC_DEMO_LOGIN=1
