# Root env — written by `neon env pull --file .env.local` for the LINKED branch (staging in dev).
# Never commit a filled copy. Never re-pull for the CI branch (see .env.ci-backend below).
NEON_BRANCH=
DATABASE_URL=                 # pooled URL, runtime queries
DATABASE_URL_UNPOOLED=        # direct URL, DDL / migrations
AWS_ACCESS_KEY_ID=            # Neon Object Storage (S3-compatible), scoped to this branch's bucket
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# .env.ci-backend — the SAME seven names, pulled ONCE for the CI branch and saved here (gitignored).
# Their values are also the GitHub Actions secrets. Re-pulling env for that branch rotates the
# AWS credentials and silently breaks CI; copy from this file instead.
